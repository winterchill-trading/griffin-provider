# Copy to .env (gitignored) and fill in. Never commit real values.
# A sandbox key (g-test-...); other keys are refused unless the adapter is created live.
GRIFFIN_API_KEY=
GRIFFIN_API_BASE_URL=https://api.griffin.com
# Optional: RFC 9421 request signing (Ed25519), see griffin-client.
GRIFFIN_SIGNING_KEY=
GRIFFIN_SIGNING_KEY_ID=
# Set to 1 to let `dune test` run the conformance suite and the GBP walk on the sandbox
# (creates sandbox legal persons, accounts and payments).
GRIFFIN_LIVE_TESTS=
